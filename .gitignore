yarn-error.log*
pnpm-debug.log*

# 아래 루트 경로는 실행 데이터 전용이다.
# 고정 테스트 자료와 검토한 증빙은 tests/fixtures/ 또는 docs/evidence/에 둔다.
/data/
/runtime/
/.runtime/
/cache/
/logs/
/backups/
/exports/
/output/
/artifacts/
/tmp/
/.tmp/
/*.db
/*.db-*
/*.sqlite
/*.sqlite-*
/*.sqlite3
/*.sqlite3-*
/*.log

