                    <button type="button" onclick="checkCaptcha();" class="krds-btn medium primary close-modal">확인</button>
                </div>
                <!-- //modal btn -->
                <!-- close button -->
                <button type="button" onclick="closeFileLimitModal();" class="krds-btn medium icon btn-close close-modal">
                    <span class="sr-only">닫기</span>
