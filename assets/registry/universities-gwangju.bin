<script src="/js/biz/sch/marked/marked.min.js"></script>
<script>

    // ======================= quick summary =========================
    async function executeSearch(dataPk, dType) {
        await handleStreamingResponse(dataPk, dType);
    }

    async function handleStreamingResponse(dataPk, dType) {
        const $qickSummary = $('#quickSummary');

        $qickSummary.addClass('krds-spinner')
        const $markdownBody = $('#quickSummary');
        marked.setOptions({breaks: true})

        try {
            const response = await fetch('/tcs/dss/getOrCreateQuickSummary.do', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    publicDataPk: dataPk,
                    dType: dType
                })
            });

            if (!response.ok) throw new Error(`HTTP `);

            const data = await response.json();
            $markdownBody.html(marked.parse(data.result));
            $qickSummary.removeClass('krds-spinner');
        } catch (error) {
            console.error("Streaming Error:", error);
            $qickSummary.removeClass('krds-spinner');
            $markdownBody.append("<p>AI가 활용사례 정보를 알려주는 퀵서머리 서비스에 오류가 발생하였습니다.<br>재시도에도 같은 메시지가 발생한다면, 서비스 운영자에게 문의 부탁드립니다.</p>");
        }
    }
    // ===============================================================
</script>
