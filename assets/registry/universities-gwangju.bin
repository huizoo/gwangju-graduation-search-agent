    <script>
    function closeFileLimitModal() {
    	$('#fileLimitCheck').removeClass('show');
    	$('#fileLimitCheck').removeClass('in');
    }
    
    function checkCaptcha() {
    	
    	if ($('#captchaCmm').val().trim() === '') {
    		alert('자동등록 방지 문자를 입력해주세요.');
    		$('#captchaCmm').focus();
    		return;
    	}
    	
    	if (fn_compareCaptCha('captchaCmm')) {
    		$.ajax({
    			url: '/cmm/cmm/check-reset.json',
    			type: 'POST',
    			dataType: 'json',
    			data: {
    				atchFileId: $('#limitAtchFileId').val(),
    				fileDetailSn: $('#limitFileDetailSn').val()
    			},
    			success: function(res) {
    				if (res.success) {
    					alert("인증이 완료되었습니다. 다시 다운로드 시도해주세요.");		
    				} else {
    					alert('처리 중 오류가 발생했습니다. 다시 시도해 주십시오.');
    				}
					closeFileLimitModal();
    			},
    			error: function(xhr) {
    				alert('장애가 발생했습니다. 다시 시도해 주십시오.');
    			}
    		});
			
    	} else {
    		alert("인증에 실패했습니다.");
    		closeFileLimitModal();
    	}
    }
    </script>
	</body>
</html>
