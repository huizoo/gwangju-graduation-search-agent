 <!-- modal : 자동등록방지 p00-025 -->
<section id="business-select-modal" class="modal-captcha krds-modal fade" role="dialog" aria-labelledby="tit_p00-025">
    <div class="modal-dialog modal-md">
        <div class="modal-content">
            <!-- modal title -->
            <div class="modal-header">
                <h2 id="tit_p00-025" class="modal-title">활용신청</h2>
            </div>
            <!-- //modal title -->
            <!-- modal contents -->
            <div class="modal-conts">
                <div class="conts-area">
                    <p>기업회원입니다. 활용신청할 서비스키를 선택해주세요
                    </p>
                </div>
            </div>
            <!-- //modal contents -->
            <!-- modal btn -->
            <div class="modal-btn btn-wrap">
                <button type="button" id="confirmY" class="krds-btn medium tertiary close-modal">프로젝트 서비스키</button>
                <button type="button" id="confirmN" class="krds-btn medium primary close-modal">개인 서비스키</button>
            </div>
            <!-- //modal btn -->
            <!-- close button -->
            <button type="button" class="krds-btn medium icon btn-close close-modal">
                <span class="sr-only">닫기</span>
                <i class="svg-icon ico-popup-close"></i>
            </button>
            <!-- //close button -->
        </div>
    </div>
    <div class="modal-back"></div>
</section>
<!-- //modal -->
<script>
    (function() {
        var modal = document.getElementById("business-select-modal");
        if (!modal) return;

        if (modal.parentNode !== document.body) {
            document.body.appendChild(modal);
        }

        modal.addEventListener("click", function(event) {
            if (!event.target.closest(".close-modal")) return;
            if (typeof krds_modal !== "undefined" && krds_modal.closeModal) {
                krds_modal.closeModal("business-select-modal");
            }
        });
    })();
</script>

