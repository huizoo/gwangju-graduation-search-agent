<script>
	const $fileDetailPopupArea = $('#fileDetailPopup')

	$(document).on('click', '.openFileDetailPopup', function(e) {
		e.preventDefault();

		const publicDataDetailPk = $(this).data('public-pk');
		$.ajax({
			url: '/tcs/dss/selectDpkDetailInfo.do',
			method: "post",
			data: {
				publicDataDetailPk: publicDataDetailPk
			},
			success: function(html) {
				$fileDetailPopupArea.empty().append(html);
				$('#file-detail-popup').addClass('show in');
				$('#file-detail-popup').find('.modal-back').addClass('in');
			},
			error	: function(data) {
				alert("에러가 발생했습니다.");
			}
		})
	})

	$(document).on('click', '.close-modal', function() {
		$('.krds-modal').removeClass('show in');
		$('.modal-back').removeClass('in')
		$fileDetailPopupArea.empty();

		document.body.classList.remove('scroll-no');
		const wrap = document.getElementById('wrap');
		wrap?.removeAttribute('inert');
		wrap?.querySelectorAll('[inert]').forEach(el => el.removeAttribute('inert'));
		document.querySelector('#krds-header .header-in')?.removeAttribute('inert');
	})
</script>
