<link rel="stylesheet" type="text/css" href="/css/common/swagger-ui.css">
<script src="/js/swagger-v4/swagger-ui-bundle.js"></script>
<script src="/js/swagger-v4/swagger-ui-standalone-preset.js"></script>

<script src="/js/biz/dss/script_errorReport.js"></script>
<script src="/js/biz/dss/script_dataOfferReqst.js"></script>
<script src="/js/handlebars/handlebars-v4.5.3.min.js"></script>
<script src="/js/handlebars/handlebars-helper.js"></script>
<script src="/js/biz/cmm/cmm/xmlBuilder2.js"></script>
<script src="/js/biz/cmm/cmm/sheet.js"></script>
<script src="/js/biz/cmm/cmm/iconv-lite.js"></script>
<script src="https://cdn.jsdelivr.net/npm/moment@2.29.4/moment.min.js"></script>
<script src="/js/biz/mvc/std/std-download-manager.js"></script>
<script src="/js/biz/mvc/std/std-detail-view.js"></script>
<script src="/js/biz/datset/script_fileDetail.js"></script>
<script type="text/javascript">
	let stdDetailView = new StdDetailView();
	window.fn_page = function(pageNo) {
		console.log(pageNo)
		const $form = $('#standDataVO')
		if (!$form.length) return

		$form.find("input[name='pageIndex']").val(pageNo)
		$form.attr("action", "/tcs/dss/selectStdDataDetailView.do")
		$form.submit()
	}

	$(function(){
		init();
		buttonEvent();
	});

	function init() {
		
        fileDetailObj.mberId = '';

		const natCoreDataSe = "D";
		const apiDataTy = "".toLowerCase();
		const stdFileExt = "RDF".toLowerCase();

		let extsn = "csv";
		if (natCoreDataSe === 'Y') {
			extsn = apiDataTy;
		} else if (natCoreDataSe === 'F') {
			extsn = stdFileExt;
		}

		const $target = $('.page-title-etc .file-ext-css');
		const cssClass = FileUtil.getCategoryClass(extsn);
		const finalClass = (cssClass === 'bg-light-gray') ? 'bg-light-primary' : cssClass;
		$target.addClass(finalClass);
		if(finalClass === 'bg-light-gray') {
			$target.text('JSON');
		}

		const pk = $('#publicDataPk').val();
		let stdDownloadManager = new StdDownloadManager();

		// favorObj.addCookie(pk, dType, subject);

        console.log("pk: ", pk)

		fileDetailObj.fn_personalRecommendData(pk);
		fileDetailObj.fn_recommendData(pk);
		// 퀵서머리
		executeSearch(pk);

		// 그리드 탭에서 조건 선택한 후 조회시 셀렉트박스와 텍스트박스 데이터 들어가도록 작업
		var colCondition = "CTPV_NM";
		var searchKeyword1 = "광주광역시";
		var searchKeyword2 = "";

		if ((colCondition !== "" && colCondition !== null) && (searchKeyword1 !== "" && searchKeyword1 !== null)) {
			$("#colCondition").val("CTPV_NM").prop("selected", true);
			$("#searchKeyword1").val("");
			$("#searchKeyword1").val("광주광역시").focus();
		}

		if ((searchKeyword2 !== "" && searchKeyword2 !== null)) {
			$("#searchKeyword1").val("");
			$("#searchKeyword2").val("").focus();
		}
	}

	function buttonEvent() {
		const $likeBtn = $('#likeBtn');
		const $hateBtn = $('#hateBtn');
		const publicDataPk = $("#publicDataPk").val();
		const $attentionPlusBtn = $('#attentionPlusBtn');
		const attentionMinusBtn = $('#attentionMinusBtn');

		$attentionPlusBtn.on('click', function() {
			fileDetailObj.fn_attentionUpdate();
		})

		attentionMinusBtn.on('click', function() {
			fileDetailObj.fn_attention('STD');
		})

		$hateBtn.on('click', function() {
			let mbrId = "";
			fileDetailObj.fn_saveHate(this, publicDataPk, mbrId)
		})

		$likeBtn.on('click', function() {
			let mbrId = ""
			fileDetailObj.fn_saveLike(this, publicDataPk, mbrId);
		})

		// 기업회원 활용신청시 종류 선택 모달
		// let businessMemberApiModal = Handlebars.getTemplate("business-member-api-modal");
		// $('#contents').append(businessMemberApiModal());

		$("#confirmY").on("click", function() {
			window.open("/tcs/dss/redirectDevAcountRequestForm.do?publicDataPk=" + publicDataPk + "&isBusinessApply=Y", '_blank');
		});

		$("#confirmN").on("click", function() {
			window.open("/tcs/dss/redirectDevAcountRequestForm.do?publicDataPk=" + publicDataPk , '_blank');
		});
	}

	const stdObj = {
		
		svcData		: [],
		svcJsonData	: [],

		fn_fileDown		: function(type) {
			var publicDataPk = $("#publicDataPk").val();
			var publicDataSj = '전국대학및전문대학정보표준데이터';
			var url = "";
			var $frm = $("#downFrm");
			
			$("#frmPublicDataPk").val(publicDataPk);
			$("#publicDataSj").val(publicDataSj);
			
			if ("xls" === type) {
				url = "/tcs/dss/stdExcelDown.do";
			} else {
				url = "/tcs/dss/stdFileDown.do";
				$("#file").val(type);
			}
			
			$frm.attr("action", url).submit();
		},

		fn_cmmnAjax			: function(data, fn_successCallback) {
			
			$.ajax({
				"url"		: data.url,
				"data"		: data,
				"success"	: fn_successCallback
			})
		},
		
		fn_pageClick		: function(pageIndex) {
			
			var dataObj = {
				"publicDataPk"	: $("#publicDataPk").val(),
				"searchKeyword2" : $("#searchKeyword2").val(),
				"pageIndex"		: pageIndex,
				"url"			: "/tcs/dss/stdFileList.do"
			}
			
			stdObj.fn_cmmnAjax(dataObj, stdObj.fn_pageClickCb);
		},
		
		fn_pageClickCb		: function(data) {
			var $stdCntArea = $("#stdCntArea");

			// 페이징 영역 삭제
			$(".pagination").remove();
			
			// 리스트 영역 삭제
			$("#stdFileListDiv").remove();
			
			// 카운트 아래에 붙이기
			$stdCntArea.after(data);
		},
		
		fn_search	: function() {
			$("#frmColCondition").val($("#colCondition").val());
			$("#frmSearchKeyword").val($("#searchKeyword1").val());
			$("#searchFrm").attr("onsubmit", "").submit();
		},
		
		fn_enter	: function(e) {
			
			if (window.event.keyCode === 13) {
				stdObj.fn_search();
			}
		},

		fn_instt_search	: function() {
			$("#searchInsttFrm").attr("onsubmit", "").submit();
		},

		fn_instt_enter	: function(e) {

			if (window.event.keyCode === 13) {
				stdObj.fn_instt_search();
			}
		}
	}
	

	const fn_list = function() {
		// history.back();
		var recmYn = "";
		if(window.location.search.includes("dataMap")){
			window.close();
		}
		if (recmYn === "Y") {
			$("#listFrm").attr("action", "/tcs/dss/selectDataSetList.do");
		}
		
		$("#listFrm").submit();
	}

	const fn_goOpenAPIRequestForm = function(publicDataPk) {
		var loginId = "";
		let mberCategory = "";
		let mberSttus = "";

		if (fn_empty(loginId)) {

			if (confirm("로그인이 필요한 서비스입니다.\n로그인 페이지로 이동하시겠습니까?")) {
				location.href = "/uim/login/loginView.do";
				return;
			} else {
				return;
			}
		}

		// 기업회원의 경우 개인 서비스키를 사용할 건지 프로젝트 키 사용할건지에 대한 유무
		if(mberCategory == 'BUSINESS' && mberSttus === 'MBST01') {
			krds_modal.openModal('business-select-modal');
			return;
		}

		fn_setCookie("currentMyMenuId", "M020105", 1);
		location.href = "/tcs/dss/redirectDevAcountRequestForm.do?publicDataPk=" + publicDataPk;
	}

	//링크 API 바로가기 : 제공처 URL 조회 후 새창 이동
	const fn_goUrlLink = function(publicDataPk) {

		$.ajax({
			url		: "/tcs/dss/selectApiLinkUrl.do",
			data	: {"publicDataPk" : publicDataPk},

			success	: function(data) {
				var jsonObj = JSON.parse(data);

				if (jsonObj.status === true) {
					var openNewWindow = window.open("about:blank");

					openNewWindow.location.href = jsonObj.linkUrl;
					fn_LinkApiRequest(jsonObj.publicDataDetailPk);
				} else {
					alert(jsonObj.errorDc);
				}
			}
		})
	}

	//링크 API일 경우 바로가기 버튼 클릭시 활용신청 INSERT(NIA 요청사항)
	const fn_LinkApiRequest = function(publicDataDetailPk) {

		$.ajax({
			url		: "/tcs/dss/addApiLinkPrcuse.do",
			type	: "POST",
			data	: {"param" : publicDataDetailPk},
			error	: function(err) {
				// console.log(err);
			}
		});
	}

	/**
	 * 페이스북 공유하기 위한 param값 설정
	 */
	function fn_SetParamSns(ty){
		//게시물의 key값 이름
		var key = new Array();
		//게시물의 key값 value
		var value = new Array();
		var originIdVal = $("#publicDataPk").val();

		key.push("publicDataPk");
		value.push(originIdVal);
		//공통함수 호출
		fn_ShareSns(key,value,ty);
	}

	var fn_urlCopy = function() {
		var t = document.createElement("textarea");
		document.body.appendChild(t);
		t.value = window.location.href;
		t.select();
		document.execCommand('copy');
		document.body.removeChild(t);

		alert("URL이 복사되었습니다.");
	}
</script>

