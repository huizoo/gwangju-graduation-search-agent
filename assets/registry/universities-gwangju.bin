		];

		// ② 매핑 찾기 함수
		function findBreadCrumb(url) {
			for (var i = 0; i < breadCrumbMap.length; i++) {
				var item = breadCrumbMap[i];
				if (typeof item.pattern === "string") {
					if (item.pattern === url) return item.crumb;
				} else {
					if (item.pattern.test(url)) return item.crumb;
				}
			}
			return null;
		}

		const currentUrl = window.location.pathname;

		// ③ 하드코딩 맵에 있으면 바로 적용
		var matched = findBreadCrumb(currentUrl);
		if (matched) {
			applyBreadCrumb(matched);
			return;
		}

		// ④ 없으면 AJAX
		$.ajax({
			url      : "/cmm/cmm/selectForBreadCrumbMenu.json",
			data     : {"url" : currentUrl},
			dataType : "json",
			success  : function(data) {
				if (data && data.breadCrumbMenu && data.breadCrumbMenu.menuPathNm) {
					const pathArray = data.breadCrumbMenu.menuPathNm.split(",");
					applyBreadCrumb(pathArray);
				} else {
					fallbackBreadCrumb();
				}
			},
			error: function() {
				console.error("메뉴 정보를 가져오는 데 실패했습니다.");
				$(".location").hide();
			}
		});

		// ⑤ 공통 브레드크럼 적용 함수
		function applyBreadCrumb(pathArray) {
			var $location = $(".location");
			$location.find(".locationDepth1").text(pathArray[1] ? pathArray[1].trim() : '');
			$location.find(".locationDepth2").text(pathArray[2] ? pathArray[2].trim() : '');
			$location.find("li:empty").remove();
			$location.find("li:last").css("font-weight", "700");
		}

		// ⑥ 기존 gnb 쿠키 기반 fallback
		function fallbackBreadCrumb() {
			var currentMenuId = fn_getCookie("currentMainMenuId");
			if (!fn_empty(currentMenuId)) {
				$(".location > .locationDepth1").text($('.gnb-menu > li.active').find('a,button').html());
				$(".location > .locationDepth2").append($('.gnb-menu > li.active').find('li.active').html());
			} else {
				$(".location").hide();
			}
			$(".location").find("li:empty").remove();
			$(".location").find("li:last").css("font-weight", "700");
		}

	});
</script>
