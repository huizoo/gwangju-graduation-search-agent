          },
          {
            "name": "district",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "../core/domain.schema.json#/$defs/District"
            }
          },
          {
            "name": "from_date",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          },
          {
            "name": "to_date",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          },
          {
            "name": "view",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "calendar",
                "sales",
                "all"
              ]
            },
            "description": "이전 내부 조회 호환: calendar는 검증 이력, sales는 sales_ready, all은 관리 기록. 사용자 일정표는 이 구분 없이 /api/results를 사용한다."
          },
          {
            "name": "review_only",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "security": [],
        "description": "내부 전체 기록·이력 호환 조회. 사용자 일정표는 /api/results를 사용한다."
      },
