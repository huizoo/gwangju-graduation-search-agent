# ollama / openai 중 선택. 변경 후 앱을 다시 시작한다.
# openai 선택은 공개 문서의 필요한 텍스트를 OpenAI로 보내는 설정이다.
# 사적 수기 메모와 이미지는 전송 대상에서 제외한다.
LLM_BACKEND=ollama

# Mac은 Ollama 앱이 실행 중이면 별도 ollama serve가 필요 없다.
# Ollama 기본 주소·모델은 config/defaults.json에서 관리한다.
# 다른 주소·설치 모델을 쓰는 PC만 OLLAMA_BASE_URL·OLLAMA_TEXT_MODEL을 추가한다.
# 모델명은 설치된 이름(ollama list)과 맞춘다.
# qwen3:8b는 재현용 기본값이며 정확성 검증 완료 모델을 뜻하지 않는다.

# OpenAI API keys: https://platform.openai.com/api-keys
# 키만 입력해도 자동 전환되지 않는다. LLM_BACKEND=openai로 선택한다.
# OpenAI 기본 모델은 config/defaults.json에서 관리한다.
OPENAI_API_KEY=

# NEIS 인증키: https://open.neis.go.kr/portal/guide/apiGuidePage.do
NEIS_API_KEY=
# 학교알리미 학년별 학생수 API 인증키
SCHOOLINFO_API_KEY=

# Tavily 대시보드 API Keys: https://app.tavily.com
TAVILY_API_KEY=

# LangSmith 선택적 실행 추적용 키 준비란.
# 현재 추적 연동은 미구현이며 키 입력만으로 활성화되지 않는다.
# 연동·검증이 끝나기 전에는 LANGSMITH_TRACING=true를 설정하지 않는다.
LANGSMITH_API_KEY=

# 다른 기본값은 config/defaults.json에서 관리한다.
# 실제 키는 .env에만 넣고 .env.example에는 넣지 않는다.
